# Frontend
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# OpenAI (for AI deconfliction)
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql://orbitron:orbitron@localhost:5432/orbitron

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=orbitron-influx-token
INFLUXDB_ORG=orbitron
INFLUXDB_BUCKET=telemetry

# Hyperledger Fabric
FABRIC_CONNECTION_PROFILE_PATH=./fabric/connection-profile.json
FABRIC_WALLET_PATH=./fabric/wallet
FABRIC_USER_ID=admin
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=orbitron

# API
API_PORT=4000
NODE_ENV=development
